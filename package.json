{
  "name": "dsh-force-collab",
  "version": "0.1.1",
  "description": "Forced collaboration for DeepSeek Harness: pick 1-6 sub-agents in the composer and every hands-on task is split across exactly that many child agents.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "subagent",
    "collaboration",
    "fanout"
  ],
  "license": "MIT",
  "author": "Jiasheng Fu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixJiashengFu/dsh-force-collab.git"
  },
  "homepage": "https://github.com/FelixJiashengFu/dsh-force-collab#readme",
  "bugs": {
    "url": "https://github.com/FelixJiashengFu/dsh-force-collab/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "prepublishOnly": "npm test"
  }
}
